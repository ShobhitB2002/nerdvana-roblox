function RecipeDB.GetByStation(station: string): { Recipe }
	local results: { Recipe } = {}
	for _, r in ipairs(RecipeDB.Recipes) do
		if r.station == station then
			table.insert(results, r)
		end
	end
	return results
end

function RecipeDB.GetById(id: string): Recipe?
	for _, r in ipairs(RecipeDB.Recipes) do
		if r.id == id then
			return r
		end
	end
	return nil
end

return RecipeDB
