function ItemDB.Get(id: string): ItemDef?
	return ItemDB.Items[id]
end

export type ItemSlot = {
	id: string,
	quantity: number?,
	durability: number?,
	quality: number?,
	rarity: string?,
}

function ItemDB.Clone(id: string): ItemSlot?
	local item = ItemDB.Items[id]
	if not item then
		return nil
	end
	local copy: ItemSlot = {
		id = item.id,
		quantity = 1,
		durability = item.durabilityMax,
		quality = nil,
		rarity = nil,
	}
	return copy
end

return ItemDB
